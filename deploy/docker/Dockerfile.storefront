# syntax=docker/dockerfile:1
# storefront（Next.js 16 standalone）。要求 next.config.ts 开启 output: "standalone"。
FROM node:26-alpine AS build
RUN npm i -g pnpm@12.18.0
WORKDIR /repo
COPY . .
RUN pnpm install --no-frozen-lockfile
# NEXT_PUBLIC_* 在构建期内联进客户端 bundle，模式必须在 build 时决定
ARG NEXT_PUBLIC_API_MODE=mock
ENV NEXT_PUBLIC_API_MODE=${NEXT_PUBLIC_API_MODE}
ARG NEXT_PUBLIC_CHANNEL=cn
ENV NEXT_PUBLIC_CHANNEL=${NEXT_PUBLIC_CHANNEL}
RUN pnpm turbo run build --filter="@mall/storefront..."

FROM node:26-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /repo/apps/storefront/.next/standalone ./
COPY --from=build /repo/apps/storefront/.next/static ./apps/storefront/.next/static
COPY --from=build /repo/apps/storefront/public ./apps/storefront/public
EXPOSE 3000
CMD ["node", "apps/storefront/server.js"]
